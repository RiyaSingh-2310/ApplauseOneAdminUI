# Vite injects VITE_* variables at build time. Set the same names in Vercel → Settings → Environment Variables.

# Local `npm run dev` uses the Vite proxy (see vite.config.ts).
# VITE_API_BASE_URL=/applauseoneapi

# Production / Vercel must use the hosted HTTPS API from Swagger:
# https://arserviceco.com/applauseoneapi/docs/
VITE_API_BASE_URL=https://arserviceco.com/applauseoneapi
VITE_USE_MOCK=false
